<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: notes, shopping list and settings are backed up and moved to a new phone. Left out: the "app" markers
     (which reminders were scheduled, whether notification permission was asked: both must start over on a new phone)
     and update state (a downloaded file that isn't there). The debug log lives in no_backup and is never included. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app.xml" />
        <exclude domain="sharedpref" path="updates.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app.xml" />
        <exclude domain="sharedpref" path="updates.xml" />
    </device-transfer>
</data-extraction-rules>

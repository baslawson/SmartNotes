<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: notes, shopping list and settings are backed up and moved to a new phone. Left out: the "app" markers
     (which reminders were scheduled, whether notification permission was asked: both must start over on a new phone),
     update state (a downloaded file that isn't there), where the app was left (state, lists) and the
     automatic-backup folder (its permission doesn't move to a new phone). The copies kept before a restore (files/backups) are left out too.
     The debug log lives in no_backup and is never included. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app.xml" />
        <exclude domain="sharedpref" path="updates.xml" />
        <exclude domain="sharedpref" path="state.xml" />
        <exclude domain="sharedpref" path="lists.xml" />
        <exclude domain="sharedpref" path="backup.xml" />
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app.xml" />
        <exclude domain="sharedpref" path="updates.xml" />
        <exclude domain="sharedpref" path="state.xml" />
        <exclude domain="sharedpref" path="lists.xml" />
        <exclude domain="sharedpref" path="backup.xml" />
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
